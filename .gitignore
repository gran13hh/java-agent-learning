# macOS / IDE
.DS_Store
.idea/
*.iml
.vscode/

# Maven build output; keep Maven Wrapper files tracked.
target/
.m2/

# Local credentials and configuration templates
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
application-local.properties

# Runtime data, private documents and logs
data/
logs/
*.log
*.pid
*.hprof
*.jfr

# Embedded database files, if introduced for local tests
*.mv.db
*.trace.db

# Python helper bytecode
__pycache__/
*.pyc

# Personal learning notes, machine download logs and local evaluation reports
/local-notes/
/docs/0[1-9]-*.md
/docs/DOWNLOADS.md
/docs/*dependency-downloads.json
/docs/evaluation/V5-RESULTS.md
